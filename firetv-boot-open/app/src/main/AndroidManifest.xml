<?xml version="1.0" encoding="utf-8"?>
<!-- Opens one app (res/values/strings.xml, target_package) after the TV starts. Not a Home replacement:
     Fire OS keeps Amazon's Home, this only puts the app in front of it once per boot. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Waits for the network before opening the app. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 10+ blocks activity starts from the background; this app-op, granted once over ADB
         (adb shell appops set io.github.mmzanes.bootopen SYSTEM_ALERT_WINDOW allow), lets the boot job open it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ package visibility: without these, getLaunchIntentForPackage returns null for every other app,
         so the target looks "not found" even when it is installed. Any app with a TV or phone entry point. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name">

        <!-- Opening this once after install takes the app out of the stopped state, so it gets BOOT_COMPLETED.
             It also opens the target app at once, which is a quick test. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Same path as a boot, sent by hand to test without rebooting:
                     adb shell am broadcast -a io.github.mmzanes.bootopen.TEST -n io.github.mmzanes.bootopen/.BootReceiver -->
                <action android:name="io.github.mmzanes.bootopen.TEST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
